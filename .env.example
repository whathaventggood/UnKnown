# Copy to .env in repository root. Credentials only here on server; never frontend.
DATABASE_URL=sqlite:///./data/unknown.db
COOKIE_SECURE=false
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5183"]
DEFAULT_TIMEZONE=Asia/Shanghai
# Empty key disables remote AI. Pricing intentionally absent by default.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TRUST_ENV=false
LLM_JSON_MODE=false
LLM_TIMEOUT_SECONDS=40
LLM_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1800
LLM_CONTEXT_CHARS=14000
LLM_USER_DAILY_REQUESTS=20
LLM_GLOBAL_DAILY_REQUESTS=100
LLM_USER_DAILY_TOKENS=50000
LLM_GLOBAL_DAILY_TOKENS=250000
# OpenAlex basic access has a limited shared-IP budget; optional key raises it.
# Verify current official terms. Wikimedia UA should identify operator.
OPENALEX_API_KEY=
INGESTION_USER_AGENT=UnKnown/0.1 (self-hosted educational explorer; configure contact)
